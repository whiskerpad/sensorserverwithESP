# 温度モニター 環境変数テンプレート
# このファイルを `.env` にコピーして編集してください
# .env は .gitignore で除外されているのでシークレットは commit されません

# サーバー
HOST=0.0.0.0
PORT=5000

# データベース パス (デフォルト: プロジェクトの data/temperature.db)
# DB_PATH=/home/pi/temperature_server/data/temperature.db

# Basic 認証 (ダッシュボード + API GET 系)
# ※ POST /api/sensor (ESP からの受信) は認証なし
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-to-secure-password
