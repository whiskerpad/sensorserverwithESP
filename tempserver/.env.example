# ============================================================
#  tempserver 設定ファイルの雛形
#
#  使い方:
#      cp .env.example .env
#      nano .env
#
#  重要: app.py は python-dotenv を使っていません。
#        この .env を読むのは systemd の EnvironmentFile= だけです。
#        手で  python3 app.py  と起動した場合、ここの設定は読まれず
#        すべて既定値で動きます。設定を効かせたいときは
#            sudo systemctl restart tempserver
#        で起動してください。
#
#  .env はリポジトリに入れないでください (.gitignore で除外済み)。
# ============================================================

# --- シリアルポート ---------------------------------------
# 既定は "auto"。/dev/ttyUSB* と /dev/ttyACM* を順に探して、
# 見つかった最初の 1 本を使います。ふつうは書く必要がありません。
#
# 変換基板を 2 本以上挿していて、そのうちの Master を名指ししたい
# ときだけ下の行のコメントを外します。XX の部分は自分の Master の
# MAC です。ls -l /dev/serial/by-id/ の出力からコピーしてください。
#
#SERIAL_PORT=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_XX:XX:XX-if00

# --- データ保持日数 ---------------------------------------
# これより古い行を 1 日 1 回まとめて削除します。既定 90 日。
# 0 や負の値は入れないでください (全部消えます)。
RETENTION_DAYS=90

# --- 補足 -------------------------------------------------
# 通信速度 (115200 bps) は app.py に直接書いてあり、この
# ファイルからは変えられません。変えたい場合は app.py の
# SERIAL_BAUD を書き換えてください。
