# ============================================================
#  改行コードの扱い
#  リポジトリ内は LF に統一する (HEAD が既に LF のため)。
#  Windows の作業ツリーが CRLF でも、git は読み取り時に正規化して
#  比較するので「全ファイルが変更扱い」にならない。
#  eol= は指定しない (作業ツリーのファイルを強制的に書換えないため)。
# ============================================================
* text=auto

# バイナリ (誤って改行変換されないよう明示)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.ico  binary
