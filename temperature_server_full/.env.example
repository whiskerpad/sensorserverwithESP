# ============================================================
#  temperature_server 環境変数テンプレート
#
#  使い方:
#    1. このファイルを .env という名前でコピー
#         cp .env.example .env
#    2. 下の各項目を自分の環境に合わせて書換え
#    3. Flask (temperature-server) を再起動
#
#  .env ファイルは .gitignore で除外されるので、
#  実際の秘密情報 (SECRET_KEY 等) はここに書いても GitHub には
#  上がりません。
# ============================================================

# ---- Flask 基本設定 ----
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ---- セキュリティ ----
# 本番運用時は必ず変更してください。
# 生成例 (Linux): python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- WiFi AP 設定 (Pi 側 hostapd/dnsmasq と一致させる) ----
AP_INTERFACE=wlan1
STATION_INTERFACE=wlan0
AP_SSID=YOUR_AP_SSID_HERE                # 例: RaspberryPi_Temperature
AP_PASSWORD=YOUR_AP_PASSWORD_HERE        # 例: 8 文字以上の任意パスワード
AP_IP=192.168.4.1

# ---- シリアル (ESP-NOW Master 経由の受信) ----
# Master ESP32 を Pi に USB 接続して ESP-NOW 中継する場合は True
SERIAL_ENABLED=False
# by-id パスを推奨 (ttyUSB0/1 の入替わりに強い)
# 実機で確認: ls -la /dev/serial/by-id/
# SERIAL_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
SERIAL_PORT=/dev/ttyUSB0

# ---- CORS (LAN 内 + Tailscale 想定) ----
# ダッシュボード/API にアクセスするオリジンをカンマ区切りで列挙
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://192.168.4.1:5000
